BUILT_IMAGE=eut_audio_vulcanexus:jazzy
DOCKER_RUNTIME=nvidia
ROS_DOMAIN_ID=12
HF_TOKEN=your_huggingface_token_here

# Name or partial name of the audio input device to use (see audio_stream_manager/config/audio_params.yaml)
DEVICE_NAME=jabra

# Log retention: number of log sessions to keep on each container start.
# Use -1 to never delete logs, or any positive integer (e.g. 2, 10).
BUILD_LOGS_TO_KEEP=2
RUNTIME_LOGS_TO_KEEP=2

# Local-only credentials for Docker Hub integration.
# This file is ignored by git via .gitignore.

DOCKERHUB_ORG=eurecatrobotica
DOCKERHUB_USERNAME=dockerrobadmin
DOCKERHUB_TOKEN=

DOCKERHUB_REPO_PREFIX=
DOCKERHUB_PULL_FIRST=true
DOCKERHUB_PUSH_AFTER_BUILD=false
# Android bridge ports (used by android-docker-compose.yaml)
ANDROID_AUDIO_PORT=17000
ANDROID_TRANSCRIPT_PORT=17001
ANDROID_DEFAULT_SAMPLERATE=16000.0

# Diarization backend: diart (legacy) or redimnet2 (REDI, independent identity manager)
DIARIZATION_BACKEND=redimnet2

# REDI (diarization_backend=redimnet2): keep speakers in MongoDB across restarts (true) or
# forget them on every start (false). Legacy diart ignores this (use_database in
# diarization_params.yaml).
REDI_USE_DATABASE=true

# ASR backend: whisper (faster-whisper, all languages incl. Catalan) or parakeet
# (NVIDIA NeMo Parakeet TDT, faster, 25 European languages, NO Catalan).
# Empty keeps asr_backend from asr_params.yaml. Used by docker-compose.yaml,
# android-docker-compose.yaml and docker-compose_mp3.yaml.
ASR_BACKEND=
